# cezar on a VPS (docs/docker.md § On a VPS): TLS for the cockpit and the preview gateway.
# Preview blocks are generated: one per pool port, each forwarded to the gateway's own port.

{
	# One explicit redirect below: with the same host on 21 ports, the automatic one picks a
	# preview port as its target.
	auto_https disable_redirects
}

(tls_site) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

http://{$CEZ_DOMAIN} {
	redir https://{host}{uri} 308
}

{$CEZ_DOMAIN} {
	import tls_site
	# The cockpit is never framed; previews are framed BY it, so their blocks leave this alone.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	request_body {
		max_size 32MB
	}
	reverse_proxy cezar:4321
}

{$CEZ_DOMAIN}:8500 {
	import tls_site
	reverse_proxy cezar:18500
}

{$CEZ_DOMAIN}:8501 {
	import tls_site
	reverse_proxy cezar:18501
}

{$CEZ_DOMAIN}:8502 {
	import tls_site
	reverse_proxy cezar:18502
}

