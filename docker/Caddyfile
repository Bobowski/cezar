# cezar on a VPS (docs/docker.md § On a VPS): TLS for the cockpit and the preview gateway.
# Generated port blocks: one per preview port, each forwarded to the gateway's own port.

{$CEZ_DOMAIN} {
	request_body {
		max_size 32MB
	}
	reverse_proxy cezar:4321
}

